PORT=4000

# WhipScribe
WHIPSCRIBE_API_KEY=tk_NoAflxTRAbzCBfJBr8x0qRFThKAT37P29-IY3Frmqx8
WHIPSCRIBE_BASE_URL=https://whipscribe.com/api/v1

# Airtable (used to push the scorecard as a new row in a base)
# Create a Personal Access Token at airtable.com/create/tokens with
# data.records:read + data.records:write scopes, and access to your base.
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=appXeysoeLhEOnzXX/tblYjbN3hKueEJZWX/viwhNuA6CMlN7ytBy?blocks=hide
AIRTABLE_TABLE_NAME=Scorecards
# Set to "false" to dry-run (scorecard is still built, nothing written to Airtable).
AIRTABLE_ENABLED=true

# Optional OpenAI-compatible provider for the structured scorecard extraction.
# Without this, a deterministic rule-based fallback extractor is used instead.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
