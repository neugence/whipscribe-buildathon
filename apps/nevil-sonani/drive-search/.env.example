# Copy to .env.local and fill in. .env.local is gitignored.

# The address the app runs at. Google must allow <APP_URL>/api/google/callback.
APP_URL=http://localhost:3000

# Google Cloud: an OAuth client of type "Web application" with the Drive API enabled.
# See README, "Connect Google Drive".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhipScribe API key (Account -> API key). Leave empty to use WhipScribe's
# anonymous free tier; transcripts then are not saved to your account.
WHIPSCRIBE_API_KEY=

# Optional: a folder on this computer to use instead of Drive, for trying the
# app without a Google client. Each subfolder shows up as a folder to pick.
DEMO_FOLDER=
